---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ 'privacy' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
eleventyExcludeFromCollections: true
---
{%- set target = site.baseUrl + ('legal/privacy' | localeUrl(locale)) -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
<meta charset="UTF-8">
<meta http-equiv="refresh" content="0; url={{ target }}">
<link rel="canonical" href="{{ target }}">
<meta name="robots" content="noindex, follow">
<title>Nordic Riser AB — Privacy Policy Has Moved</title>
</head>
<body>
<p>Our Privacy Policy has moved to <a href="{{ target }}">{{ target }}</a>. If you are not redirected automatically, please click the link.</p>
</body>
</html>
