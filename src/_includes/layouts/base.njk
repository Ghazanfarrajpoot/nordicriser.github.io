{%- set t = locales[locale] -%}
{#- Falls back to English wholesale when a page doesn't exist yet for this locale
    (e.g. /work/, or the IT-led homepage restructure, ahead of Phase 8 translation). -#}
{%- set pageData = t.pages[pageKey] or locales.en.pages[pageKey] -%}
{#- meta.title/description let a page override the punchy hero copy with SEO-tuned text; falls back to hero.h1/body for pages without an override. -#}
{%- set pageTitle = pageData.meta.title if pageData.meta else (pageData.hero.h1 + " — Nordic Riser AB") -%}
{%- set pageDesc = pageData.meta.description if pageData.meta else pageData.hero.body -%}
{#- True when this locale has no translation of this page at all, i.e. the
    pageData fallback above just kicked in — the URL still resolves and
    renders (in English), but it's a byte-for-byte duplicate of the English
    original, not a distinct translated page. Canonicalize to the English
    URL and don't index the duplicate, rather than telling search engines
    this locale URL is original, canonical content. A page's own explicit
    `robots` front matter (e.g. the noindex portal bridge page) still wins
    via the `default()` below. -#}
{%- set isEnglishFallback = (locale != 'en') and (not t.pages[pageKey]) -%}
{%- set canonicalLocale = 'en' if isEnglishFallback else locale -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ dir }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="robots" content="{{ robots | default('noindex, follow' if isEnglishFallback else 'index, follow') }}">
  <link rel="canonical" href="{{ site.baseUrl }}{{ pageSlug | localeUrl(canonicalLocale) }}">
  <meta property="og:site_name" content="Nordic Riser AB">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ locale }}">
  <meta property="og:url" content="{{ site.baseUrl }}{{ pageSlug | localeUrl(locale) }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  {%- if pageKey == "home" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Nordic Riser AB",
    "url": "{{ site.baseUrl }}",
    "email": "info@nordicriser.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Stockholm",
      "addressCountry": "SE"
    }
  }
  </script>
  {%- endif %}
  {%- if pageKey == "globalReach" and pageData.faq %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in pageData.faq %}
      {
        "@type": "Question",
        "name": {{ item.q | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.a | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {%- endif %}
  {%- if not singleLocale %}
  {%- for l in site.locales %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ site.baseUrl }}{{ pageSlug | localeUrl(l.code) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}{{ pageSlug | localeUrl('en') }}">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {%- if dir == "rtl" %}
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
  {%- endif %}
  <link rel="stylesheet" href="/assets/css/styles.css">
  <link rel="stylesheet" href="/assets/css/pillars.css">
  <link rel="stylesheet" href="/assets/css/pages.css">
  {%- if pageKey == "nrBos" %}
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/product-overview.css">
  <link rel="stylesheet" href="/assets/css/nrb-overview.css">
  {%- endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
{{ content | safe }}
{%- if pageKey == "nrBos" %}
<script src="/assets/js/nrb-overview.js" defer></script>
{%- endif %}
</body>
</html>
