---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ 'work/nr-bos' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
layout: layouts/page.njk
pageKey: nrBos
pageSlug: work/nr-bos
---
{%- set t = locales[locale] -%}
{#- Falls back to English until this page is translated for this locale. -#}
{%- set p = t.pages.nrBos or locales.en.pages.nrBos -%}
{%- set ov = t.productOverviews.nrBos or locales.en.productOverviews.nrBos -%}
{#- Status-badge labels must match whichever language p/ov actually fell back to, not the page's own locale. -#}
{%- set pCommon = t.common if t.pages.nrBos else locales.en.common -%}
{%- set ovCommon = t.common if t.productOverviews.nrBos else locales.en.common -%}
{%- set statusAvailable = pCommon.statusAvailable -%}
{%- set statusPlanned = pCommon.statusPlanned -%}
{%- set ovStatusAvailable = ovCommon.statusAvailable -%}
{% import "partials/nrb-overview.njk" as nrb2 %}
{% import "partials/icons.njk" as icons %}

<section class="page-hero">
  <div class="page-hero-inner" data-animate>
    <span class="page-hero-label">{{ p.hero.label }}</span>
    <h1>{{ p.hero.h1 }}</h1>
    {%- if p.hero.tagline %}
    <p class="page-hero-tagline">{{ p.hero.tagline }}</p>
    {%- endif %}
    <p>{{ p.hero.body }}</p>
    <div class="hero-ctas">
      <a href="{{ 'contact' | localeUrl(locale) }}" class="btn-primary" data-analytics-event="nr_bos_demo_cta">{{ p.cta.cta }}</a>
      <a href="{{ 'contact' | localeUrl(locale) }}?purpose=nrbos-trial" class="btn-secondary" data-analytics-event="nr_bos_trial_cta">{{ p.cta.trialCta }}</a>
    </div>
  </div>
</section>

<div class="breadcrumb">
  <div class="breadcrumb-inner">
    <a href="{{ '' | localeUrl(locale) }}">{{ t.common.home }}</a> &rsaquo;
    <a href="{{ 'work' | localeUrl(locale) }}">{{ t.pages.work.breadcrumb or locales.en.pages.work.breadcrumb }}</a> &rsaquo;
    <span>{{ p.breadcrumb }}</span>
  </div>
</div>

{%- if p.workflow %}
<section class="section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.workflow.label }}</span>
    <h2 class="section-title">{{ p.workflow.title }}</h2>
    <div class="steps-grid nrb-workflow-grid">
      {%- for step in p.workflow.steps %}
      <div class="step">
        <div class="step-number">{{ loop.index }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if p.moduleMap %}
<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.moduleMap.label }}</span>
    <h2 class="section-title">{{ p.moduleMap.title }}</h2>
    <div class="portfolio-grid nrb-module-grid">
      {%- for m in p.moduleMap.items %}
      <div class="portfolio-card">
        <div class="portfolio-icon">{{ icons.icon(m.icon) }}</div>
        <span class="status-badge status-badge--{{ m.status }}">{{ statusAvailable if m.status == 'available' else statusPlanned }}</span>
        <h3>{{ m.name }}</h3>
        <p>{{ m.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if p.industries %}
<section class="section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.industries.label }}</span>
    <h2 class="section-title">{{ p.industries.title }}</h2>
    <div class="portfolio-grid nrb-industry-grid">
      {%- for ind in p.industries.items %}
      <div class="portfolio-card">
        <h3>{{ ind.name }}</h3>
        <p>{{ ind.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if p.integrations %}
<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.integrations.label }}</span>
    <h2 class="section-title">{{ p.integrations.title }}</h2>
    <div class="portfolio-grid nrb-module-grid">
      {%- for i in p.integrations.items %}
      <div class="portfolio-card">
        <div class="portfolio-icon">{{ icons.icon(i.icon) }}</div>
        <span class="status-badge status-badge--{{ i.status }}">{{ statusAvailable if i.status == 'available' else statusPlanned }}</span>
        <h3>{{ i.name }}</h3>
        <p>{{ i.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="section" style="padding-bottom: 0;">
  <div class="section-inner-narrow">
    {{ nrb2.overview(ov, ovStatusAvailable) }}
  </div>
</section>

<section class="section nrb-scope">
  <div class="section-inner-narrow">
    <a href="{{ 'work' | localeUrl(locale) }}" class="nrb-back">&larr; {{ p.backLink }}</a>

    {%- for block in p.tour %}
    <div class="nrb-block">
      <div class="nrb-block-head">
        <span class="section-label">{{ block.eyebrow }}</span>
        <span class="status-badge status-badge--available">{{ statusAvailable }}</span>
        <h2 class="nrb-block-title">{{ block.title }}</h2>
        <p class="nrb-block-body">{{ block.body }}</p>
      </div>
      <div class="nrb-shots nrb-shots-{{ block.shots.length }}">
        {%- for shot in block.shots %}
        <figure class="nrb-frame">
          <div class="nrb-frame-bar"><i></i><i></i><i></i></div>
          <img src="/assets/img/nr-bos/{{ shot.file }}" alt="{{ shot.caption }}" loading="lazy" width="1568" height="710">
          <figcaption>{{ shot.caption }}</figcaption>
        </figure>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

{%- if p.demoForm %}
{%- set df = p.demoForm %}
<section class="contact-section">
  <div class="contact-inner contact-inner--single" data-animate>
    <div class="form-block">
      <span class="section-label">{{ df.label }}</span>
      <h2>{{ df.title }}</h2>
      <p class="form-intro">{{ df.intro }}</p>

      <form class="consultation-form" id="nrbosDemoForm">
        <div class="form-row">
          <div class="field">
            <label for="nrbosName">{{ df.name }} <span class="required">*</span></label>
            <input type="text" id="nrbosName" name="name" placeholder="{{ df.namePlaceholder }}" required autocomplete="name">
          </div>
          <div class="field">
            <label for="nrbosCompany">{{ df.company }} <span class="required">*</span></label>
            <input type="text" id="nrbosCompany" name="company" placeholder="{{ df.companyPlaceholder }}" required autocomplete="organization">
          </div>
        </div>

        <div class="field">
          <label for="nrbosEmail">{{ df.email }} <span class="required">*</span></label>
          <input type="email" id="nrbosEmail" name="email" placeholder="{{ df.emailPlaceholder }}" required autocomplete="email">
        </div>

        <div class="form-row">
          <div class="field">
            <label for="nrbosSize">{{ df.size }} <span class="required">*</span></label>
            <select id="nrbosSize" name="size" required>
              {%- for opt in df.sizeOptions %}
              <option value="{{ opt.value }}"{% if loop.first %} disabled selected{% endif %}>{{ opt.label }}</option>
              {%- endfor %}
            </select>
          </div>
          <div class="field">
            <label for="nrbosIndustry">{{ df.industry }} <span class="required">*</span></label>
            <select id="nrbosIndustry" name="industry" required>
              {%- for opt in df.industryOptions %}
              <option value="{{ opt.value }}"{% if loop.first %} disabled selected{% endif %}>{{ opt.label }}</option>
              {%- endfor %}
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="nrbosMainChallenge">{{ df.mainChallenge }} <span class="required">*</span></label>
            <input type="text" id="nrbosMainChallenge" name="mainChallenge" placeholder="{{ df.mainChallengePlaceholder }}" required>
          </div>
          <div class="field">
            <label for="nrbosUsers">{{ df.users }} <span class="required">*</span></label>
            <input type="number" id="nrbosUsers" name="users" placeholder="{{ df.usersPlaceholder }}" min="1" required>
          </div>
        </div>

        <div class="field">
          <label for="nrbosMessage">{{ df.message }}</label>
          <textarea id="nrbosMessage" name="message" placeholder="{{ df.messagePlaceholder }}"></textarea>
        </div>

        <p class="form-consent">{{ df.consent }}</p>

        <button type="submit" class="btn-submit">{{ df.submit }}</button>
      </form>

      <div class="form-success" id="nrbosDemoFormSuccess">
        <h3>{{ df.success.title }}</h3>
        <p>{{ df.success.body }}</p>
      </div>
    </div>
  </div>
</section>
{%- endif %}

<section class="cta-section">
  <div class="cta-box" data-animate>
    <h2>{{ p.cta.title }}</h2>
    <p>{{ p.cta.body }}</p>
    <div class="cta-box-buttons">
      <a href="{{ 'contact' | localeUrl(locale) }}" class="btn-cta" data-analytics-event="nr_bos_demo_cta">{{ p.cta.cta }}</a>
      <a href="{{ 'contact' | localeUrl(locale) }}?purpose=nrbos-trial" class="btn-secondary" data-analytics-event="nr_bos_trial_cta">{{ p.cta.trialCta }}</a>
    </div>
  </div>
</section>
