{%- set t = locales[locale] -%}
{%- set p = t.pages.home.pillars -%}
<section class="section pillars-section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.label }}</span>
    <h2 class="section-title">{{ p.title }}</h2>
    <p class="section-sub">{{ p.sub }}</p>
    <div class="pillars-grid">
      <a href="{{ 'consulting' | localeUrl(locale) }}" class="pillar-card pillar-card-consulting">
        <div class="pillar-card-icon">{{ p.consulting.icon }}</div>
        <h3>{{ p.consulting.title }}</h3>
        <p class="pillar-card-promise">{{ p.consulting.promise }}</p>
        <ul class="pillar-card-bullets">
          {%- for b in p.consulting.bullets %}
          <li>{{ b }}</li>
          {%- endfor %}
        </ul>
        <span class="pillar-card-link">{{ p.learnMore }}</span>
      </a>
      <a href="{{ 'it-services' | localeUrl(locale) }}" class="pillar-card pillar-card-it">
        <div class="pillar-card-icon">{{ p.itServices.icon }}</div>
        <h3>{{ p.itServices.title }}</h3>
        <p class="pillar-card-promise">{{ p.itServices.promise }}</p>
        <ul class="pillar-card-bullets">
          {%- for b in p.itServices.bullets %}
          <li>{{ b }}</li>
          {%- endfor %}
        </ul>
        <span class="pillar-card-link">{{ p.learnMore }}</span>
      </a>
      <a href="{{ 'global-reach' | localeUrl(locale) }}" class="pillar-card pillar-card-global">
        <div class="pillar-card-icon">{{ p.globalReach.icon }}</div>
        <h3>{{ p.globalReach.title }}</h3>
        <p class="pillar-card-promise">{{ p.globalReach.promise }}</p>
        <ul class="pillar-card-bullets">
          {%- for b in p.globalReach.bullets %}
          <li>{{ b }}</li>
          {%- endfor %}
        </ul>
        <span class="pillar-card-link">{{ p.learnMore }}</span>
      </a>
    </div>
  </div>
</section>
