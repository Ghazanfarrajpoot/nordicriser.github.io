{%- set t = locales[locale] -%}
{%- set navWorkLabel = t.nav.work or locales.en.nav.work -%}
<footer class="footer">
  <div class="footer-main{% if pageKey != 'consulting' %} footer-main--compact{% endif %}">
    <div class="footer-brand">
      <a href="{{ '' | localeUrl(locale) }}" class="footer-logo">Nordic Riser <span>AB</span></a>
      <p>{{ t.footer.brandBlurb }}</p>
      <div class="footer-address">
        <strong>{{ t.footer.addressHeading }}</strong>
        Nordic Riser AB<br>
        Stockholm, Sweden<br>
        {%- if "[ORG_NR]" not in t.footer.orgNrValue %}
        {{ t.footer.orgNrLabel }} {{ t.footer.orgNrValue }}<br>
        {%- endif %}
        <a href="mailto:info@nordicriser.com">info@nordicriser.com</a>
      </div>
    </div>
    <div class="footer-services-group">
      <div class="footer-col">
        <h4>{{ t.footer.divisions.itServicesHeading }}</h4>
        <ul>
          {%- for link in t.footer.divisions.itServicesLinks %}
          <li><a href="{{ (link.target or 'services') | localeUrl(locale) }}">{{ link.label }}</a></li>
          {%- endfor %}
          <li><a href="{{ 'work' | localeUrl(locale) }}">{{ navWorkLabel }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t.footer.divisions.globalReachHeading }}</h4>
        <ul>
          {%- for link in t.footer.divisions.globalReachLinks %}
          <li><a href="{{ link.external or (('global-reach' | localeUrl(locale))) }}">{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t.footer.divisions.consultingHeading }}</h4>
        <ul>
          {%- for link in t.footer.divisions.consultingLinks %}
          <li><a href="{{ 'consulting' | localeUrl(locale) }}#{{ link.anchor }}">{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
    <div class="footer-col">
      <h4>{{ t.footer.firmHeading }}</h4>
      <ul>
        <li><a href="{{ 'about' | localeUrl(locale) }}">{{ t.footer.firmLinks.about }}</a></li>
        <li><a href="{{ 'contact' | localeUrl(locale) }}">{{ t.footer.firmLinks.contact }}</a></li>
        <li><a href="https://portal.nordicriser.com">{{ t.footer.firmLinks.memberPortal }}</a></li>
      </ul>
    </div>
    {%- set legalHeading = t.footer.legalHeading or locales.en.footer.legalHeading -%}
    {%- set legalLinks = t.footer.legalLinks or locales.en.footer.legalLinks -%}
    <div class="footer-col">
      <h4>{{ legalHeading }}</h4>
      <ul>
        <li><a href="{{ 'legal/privacy' | localeUrl(locale) }}">{{ legalLinks.privacy }}</a></li>
        <li><a href="{{ 'legal/terms' | localeUrl(locale) }}">{{ legalLinks.terms }}</a></li>
        <li><a href="{{ 'legal/dpa' | localeUrl(locale) }}">{{ legalLinks.dpa }}</a></li>
        <li><a href="{{ 'legal/subprocessors' | localeUrl(locale) }}">{{ legalLinks.subprocessors }}</a></li>
        <li><a href="{{ 'security' | localeUrl(locale) }}">{{ legalLinks.security }}</a></li>
      </ul>
    </div>
    {%- if pageKey == "consulting" %}
    <div class="footer-col">
      <h4>{{ t.footer.complianceHeading }}</h4>
      <div class="footer-disclaimer-box">
        <strong>{{ t.footer.disclaimerHeading }}</strong>
        <p>{{ t.footer.disclaimer }}</p>
      </div>
    </div>
    {%- endif %}
  </div>
  <div class="footer-bottom">
    <span>{{ t.footer.copyright }}</span>
    <ul class="footer-bottom-links">
      <li><a href="{{ 'legal/privacy' | localeUrl(locale) }}">{{ t.footer.legalLinks.privacy }}</a></li>
      <li><a href="{{ 'legal/terms' | localeUrl(locale) }}">{{ t.footer.legalLinks.terms }}</a></li>
      <li><a href="{{ 'contact' | localeUrl(locale) }}">{{ t.footer.firmLinks.contact }}</a></li>
      <li><a href="https://portal.nordicriser.com">{{ t.footer.firmLinks.memberPortal }}</a></li>
    </ul>
  </div>
</footer>
