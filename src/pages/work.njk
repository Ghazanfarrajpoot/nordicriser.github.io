---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ 'work' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
layout: layouts/page.njk
pageKey: work
pageSlug: work
---
{%- set t = locales[locale] -%}
{#- Falls back to English until this page is translated for this locale (Phase 8). -#}
{%- set p = t.pages.work or locales.en.pages.work -%}
{% import "partials/icons.njk" as icons %}

<section class="page-hero">
  <div class="page-hero-inner" data-animate>
    <span class="page-hero-label">{{ p.hero.label }}</span>
    <h1>{{ p.hero.h1 }}</h1>
    <p>{{ p.hero.body }}</p>
  </div>
</section>

<div class="breadcrumb">
  <div class="breadcrumb-inner">
    <a href="{{ '' | localeUrl(locale) }}">{{ t.common.home }}</a> &rsaquo; <span>{{ p.breadcrumb }}</span>
  </div>
</div>

<section class="section">
  <div class="section-inner" data-animate>
    <div class="case-study-list">
      {%- for cs in p.caseStudies %}
      <div class="case-study-card{% if cs.featured %} case-study-card--featured{% endif %}">
        {%- if cs.featured %}<span class="case-study-badge">{{ cs.featuredLabel }}</span>{%- endif %}
        <div class="case-study-card__band">
          <span class="case-study-type">{{ cs.type }}</span>
          <h2>{{ cs.title }}</h2>
        </div>
        <div class="case-study-card__body">
          <div class="case-study-meta">
            <div class="case-study-row">
              <span class="case-study-row-label">{{ cs.challengeLabel }}</span>
              <p>{{ cs.challenge }}</p>
            </div>
            <div class="case-study-row">
              <span class="case-study-row-label">{{ cs.buildLabel }}</span>
              <p>{{ cs.build }}</p>
            </div>
            <div class="case-study-row">
              <span class="case-study-row-label">{{ cs.stackLabel }}</span>
              <div class="case-study-stack">
                {%- for item in cs.stack %}<span class="stack-pill">{{ item }}</span>{% endfor %}
              </div>
            </div>
            <div class="case-study-row">
              <span class="case-study-row-label">{{ cs.resultLabel }}</span>
              <p>{{ cs.result }}</p>
            </div>
          </div>
          {%- if cs.link %}
          <a href="{{ cs.link | localeUrl(locale) }}" class="service-link">{{ cs.linkLabel }} →</a>
          {%- endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
    <p class="flagship-note">{{ p.note }}</p>
  </div>
</section>

<section class="cta-section">
  <div class="cta-box" data-animate>
    <h2>{{ p.cta.title }}</h2>
    <p>{{ p.cta.body }}</p>
    <a href="{{ 'contact' | localeUrl(locale) }}" class="btn-cta">{{ p.cta.cta }}</a>
  </div>
</section>
