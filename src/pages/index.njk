---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ '' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
layout: layouts/page.njk
pageKey: home
pageSlug: ""
---
{%- set t = locales[locale] -%}
{#- Falls back to English until this locale is translated to the new IT-led
    homepage structure (Phase 8) — old and new home shapes don't mix. -#}
{%- set home = t.pages.home if t.pages.home.proofBar else locales.en.pages.home -%}
{% import "partials/icons.njk" as icons %}

<section class="hero">
  <div class="hero-inner" data-animate>
    <span class="hero-label">{{ home.hero.label }}</span>
    <h1>{{ home.hero.h1 }}</h1>
    <p>{{ home.hero.body }}</p>
    <div class="hero-ctas">
      <a href="{{ 'work' | localeUrl(locale) }}" class="btn-primary">{{ home.hero.cta }}</a>
      <a href="{{ 'contact' | localeUrl(locale) }}" class="btn-secondary">{{ home.hero.ctaSecondary }}</a>
    </div>
  </div>
</section>

{%- if home.pillars %}
<section class="section pillars-section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.pillars.label }}</span>
    <h2 class="section-title">{{ home.pillars.title }}</h2>
    <div class="pillars-grid">
      {%- for p in home.pillars.items %}
      <a href="{{ p.link | localeUrl(locale) }}" class="pillar-card pillar-card-{{ p.variant }}">
        <div class="pillar-card-icon">{{ icons.icon(p.icon) }}</div>
        <span class="section-label">{{ p.tag }}</span>
        <h3>{{ p.title }}</h3>
        <p class="pillar-card-promise">{{ p.body }}</p>
        <span class="pillar-card-link">{{ p.cta }} →</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="proof-bar">
  <div class="proof-bar-inner" data-animate>
    {%- for s in home.proofBar.stats %}
    <div class="proof-stat">
      <div class="proof-stat-value">{{ s.value }}</div>
      <div class="proof-stat-label">{{ s.label }}</div>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.whatWeBuild.label }}</span>
    <h2 class="section-title">{{ home.whatWeBuild.title }}</h2>
    <div class="services-grid">
      {%- for c in home.whatWeBuild.cards %}
      <div class="service-card">
        <div class="service-icon">{{ icons.icon(c.icon) }}</div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.body }}</p>
        {%- if c.builtWith %}
        <p class="built-with"><strong>{{ t.common.builtWith }}</strong> {{ c.builtWith }}</p>
        {%- endif %}
        {%- if c.seeText %}
        <p class="built-with">{{ c.seeLabel }} <a href="{{ c.seeLink | localeUrl(locale) }}">{{ c.seeText }}</a></p>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.featuredWork.label }}</span>
    <h2 class="section-title">{{ home.featuredWork.title }}</h2>
    <div class="work-teaser-grid">
      {%- for item in home.featuredWork.items %}
      <a href="{{ item.link | localeUrl(locale) }}" class="work-teaser-card{% if item.featured %} work-teaser-card--featured{% endif %}">
        {%- if item.featured %}<span class="case-study-badge">{{ item.featuredLabel }}</span>{%- endif %}
        <div class="work-teaser-card__band">
          <span class="case-study-type">{{ item.type }}</span>
          <h3>{{ item.title }}</h3>
        </div>
        <div class="work-teaser-card__body">
          <p>{{ item.oneLiner }}</p>
          <span class="service-link">{{ item.linkLabel or t.common.readMore }}</span>
        </div>
      </a>
      {%- endfor %}
    </div>
    <div class="work-teaser-cta">
      <a href="{{ home.featuredWork.ctaLink | localeUrl(locale) }}" class="btn-primary">{{ home.featuredWork.cta }}</a>
    </div>
  </div>
</section>

<section class="gr-teaser">
  <div class="gr-teaser-inner" data-animate>
    <div class="gr-teaser-text">
      <span class="section-label">{{ home.productSpotlight.label }}</span>
      <h2 class="section-title">{{ home.productSpotlight.title }}</h2>
      <p class="section-sub">{{ home.productSpotlight.body }}</p>
      <ul class="gr-teaser-bullets">
        {%- for b in home.productSpotlight.bullets %}
        <li>{{ b }}</li>
        {%- endfor %}
      </ul>
      <a href="https://portal.nordicriser.com" class="btn-cta">{{ home.productSpotlight.cta }}</a>
    </div>
    <div class="gr-teaser-visual" aria-hidden="true">
      <div class="gr-mock gr-mock-compact">
        <div class="gr-mock-toolbar">
          <span class="gr-mock-dot"></span><span class="gr-mock-dot"></span><span class="gr-mock-dot"></span>
        </div>
        <div class="gr-mock-notes">{{ icons.icon('pencil') }}</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.howWeWork.label }}</span>
    <h2 class="section-title">{{ home.howWeWork.title }}</h2>
    <div class="steps-grid">
      {%- for step in home.howWeWork.steps %}
      <div class="step">
        <div class="step-number">{{ loop.index }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.technology.label }}</span>
    <h2 class="section-title">{{ home.technology.title }}</h2>
    <div class="tech-stack-grid">
      {%- for g in home.technology.groups %}
      <div class="tech-stack-group">
        <h4>{{ g.category }}</h4>
        <p>{{ g.items }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section why-section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ home.whyUs.label }}</span>
    <h2 class="section-title">{{ home.whyUs.title }}</h2>
    <div class="why-grid">
      {%- for c in home.whyUs.cards %}
      <div class="why-card">
        <div class="check">{{ icons.icon(c.icon) }}</div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="consulting-band">
  <div class="consulting-band-inner" data-animate>
    <span class="section-label">{{ home.consultingBand.label }}</span>
    <h2 class="section-title">{{ home.consultingBand.title }}</h2>
    <p class="section-sub">{{ home.consultingBand.body }}</p>
    <a href="{{ 'consulting' | localeUrl(locale) }}" class="btn-primary">{{ home.consultingBand.cta }}</a>
  </div>
</section>

<section class="cta-section">
  <div class="cta-box" data-animate>
    <h2>{{ home.finalCta.title }}</h2>
    <p>{{ home.finalCta.body }}</p>
    <a href="{{ 'contact' | localeUrl(locale) }}" class="btn-cta">{{ home.finalCta.cta }}</a>
    <div class="contact-strip">
      <div class="contact-item">
        <span>{{ t.common.emailLabel }}</span>
        <a href="mailto:info@nordicriser.com">info@nordicriser.com</a>
      </div>
      <div class="contact-item">
        <span>{{ t.common.websiteLabel }}</span>
        <a href="https://www.nordicriser.com">www.nordicriser.com</a>
      </div>
    </div>
  </div>
</section>
