{%- elif name == "check" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5 9.5 17.5 19.5 6.5"/></svg>
{%- elif name == "whiteboard" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M12 16.5V20M8.5 20h7"/><path d="M6.5 9.5 10 12l2.5-2.5L17.5 13"/></svg>
{%- elif name == "translate" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6.5h9M8 4v2.5M6 6.5c0 3.5 2.7 6 6 7"/><path d="M11 6.5c-1 3-3.3 5.3-6 6.5"/><path d="M13.5 20 17.5 11.5 21.5 20M14.7 17.3h5.6"/></svg>
{%- elif name == "mail" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 6.5 8 6.5 8-6.5"/></svg>
{%- elif name == "clock" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3.2 2"/></svg>
{%- elif name == "calendar" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 9.5h16M8 3.5v4M16 3.5v4"/></svg>
{%- elif name == "phone" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5h3.2l1.4 4.2-2 1.6a10.5 10.5 0 0 0 5.5 5.5l1.6-2 4.2 1.4V18a1.5 1.5 0 0 1-1.6 1.5C10.7 19 5 13.3 4.5 6.6A1.5 1.5 0 0 1 5 4.5Z"/></svg>
{%- elif name == "pin" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-6.1-6.5-11A6.5 6.5 0 0 1 18.5 10c0 4.9-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
{%- elif name == "question" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M9.5 9.3a2.5 2.5 0 0 1 4.9.7c0 1.7-2.4 2-2.4 3.5"/><circle cx="12" cy="16.5" r="0.15" fill="currentColor" stroke-width="1"/></svg>
{%- elif name == "sparkle" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 13.4 9l5.6 1.4-5.6 1.4L12 17.4 10.6 11.8 5 10.4l5.6-1.4Z"/><path d="M18.5 16.5 19.1 18.5 21.1 19.1 19.1 19.7 18.5 21.7 17.9 19.7 15.9 19.1 17.9 18.5Z"/></svg>
