---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ 'legal/privacy' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
layout: layouts/page.njk
pageKey: privacy
pageSlug: legal/privacy
---
{%- set t = locales[locale] -%}
{%- set isFallback = not t.pages.privacy -%}
{%- set p = t.pages.privacy or locales.en.pages.privacy -%}
{%- set s = p.sections -%}
{%- set legalIndex = t.pages.legal or locales.en.pages.legal -%}
{% import "partials/icons.njk" as icons %}

<section class="page-hero">
  <div class="page-hero-inner" data-animate>
    <span class="page-hero-label">{{ p.hero.label }}</span>
    <h1>{{ p.hero.h1 }}</h1>
    <p>{{ p.hero.body }}</p>
  </div>
</section>

<div class="breadcrumb">
  <div class="breadcrumb-inner">
    <a href="{{ '' | localeUrl(locale) }}">{{ t.common.home }}</a> &rsaquo; <a href="{{ 'legal' | localeUrl(locale) }}">{{ legalIndex.breadcrumb }}</a> &rsaquo; <span>{{ p.breadcrumb }}</span>
  </div>
</div>

<div class="content-wrap"{% if isFallback %} dir="ltr"{% endif %}>

  {%- if isFallback %}
  <div class="translation-notice">{{ locales.en.common.legalPendingTranslationPrefix }}{{ site.locales | localeName(locale) }}{{ locales.en.common.legalPendingTranslationSuffix }}</div>
  {%- elif locale != "en" %}
  <div class="translation-notice">{{ p.translationNotice }}</div>
  {%- endif %}

  <aside class="toc">
    <span class="toc-label">{{ p.tocLabel }}</span>
    <ul class="toc-list">
      {%- for item in p.toc %}
      <li><a href="#s{{ loop.index }}">{{ item }}</a></li>
      {%- endfor %}
    </ul>
  </aside>

  <div class="doc-body">
    <div class="updated-badge">{{ icons.icon('calendar') }} {{ p.updatedBadge }}</div>
    {%- if p.whatChanged %}
    <div class="info-box what-changed"><p>{{ p.whatChanged }}</p></div>
    {%- endif %}

    <div class="doc-section" id="s1">
      <h2><span class="sec-num">1</span> {{ s.s1.title }}</h2>
      {%- for para in s.s1.body %}<p>{{ para }}</p>{% endfor %}
    </div>

    <div class="doc-section" id="s2">
      <h2><span class="sec-num">2</span> {{ s.s2.title }}</h2>
      {%- for para in s.s2.intro %}<p>{{ para }}</p>{% endfor %}
      <div class="contact-card">
        <div>
          <strong>Nordic Riser AB</strong><br>
          {%- if "[STREET_ADDRESS]" not in t.pages.contact.sidebar.addressValue %}
          {{ t.pages.contact.sidebar.addressValue }}<br>
          {%- endif %}
          {%- if "[ORG_NR]" not in t.footer.orgNrValue %}
          {{ t.footer.orgNrLabel }} {{ t.footer.orgNrValue }}<br>
          {%- endif %}
          Email: info@nordicriser.com
        </div>
      </div>
      <p>{{ s.s2.contactNote }}</p>
    </div>

    <div class="doc-section" id="s3">
      <h2><span class="sec-num">3</span> {{ s.s3.title }}</h2>
      {%- for para in s.s3.body %}<p>{{ para }}</p>{% endfor %}
    </div>

    <div class="doc-section" id="s4">
      <h2><span class="sec-num">4</span> {{ s.s4.title }}</h2>
      {%- for sub in s.s4.subheadings %}
      <h3>{{ sub.title }}</h3>
      <p>{{ sub.intro }}</p>
      <ul>{% for li in sub.list %}<li>{{ li }}</li>{% endfor %}</ul>
      {%- endfor %}
    </div>

    <div class="doc-section" id="s5">
      <h2><span class="sec-num">5</span> {{ s.s5.title }}</h2>
      <p>{{ s.s5.intro }}</p>
      <table class="data-table">
        <thead><tr>{% for h in s.s5.table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
          {%- for row in s.s5.table.rows %}
          <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
          {%- endfor %}
        </tbody>
      </table>
      <div class="info-box"><p>{{ s.s5.note }}</p></div>
    </div>

    <div class="doc-section" id="s6">
      <h2><span class="sec-num">6</span> {{ s.s6.title }}</h2>
      {%- for sub in s.s6.subheadings %}
      <h3>{{ sub.title }}</h3>
      <p>{{ sub.intro }}</p>
      {%- if sub.list %}
      <ul>{% for li in sub.list %}<li>{{ li }}</li>{% endfor %}</ul>
      {%- endif %}
      {%- if sub.outro %}<p>{{ sub.outro }}</p>{% endif %}
      {%- endfor %}
    </div>

    <div class="doc-section" id="s7">
      <h2><span class="sec-num">7</span> {{ s.s7.title }}</h2>
      {%- for para in s.s7.body %}<p>{{ para }}</p>{% endfor %}
      <div class="info-box"><p><a href="{{ 'legal/subprocessors' | localeUrl(locale) }}">{{ s.s7.linkLabel }} →</a></p></div>
    </div>

    <div class="doc-section" id="s8">
      <h2><span class="sec-num">8</span> {{ s.s8.title }}</h2>
      <p>{{ s.s8.intro }}</p>
      <ul>{% for li in s.s8.list %}<li>{{ li }}</li>{% endfor %}</ul>
      <p>{{ s.s8.outro }}</p>
    </div>

    <div class="doc-section" id="s9">
      <h2><span class="sec-num">9</span> {{ s.s9.title }}</h2>
      <p>{{ s.s9.intro }}</p>
      <ul>{% for li in s.s9.list %}<li>{{ li }}</li>{% endfor %}</ul>
      <p>{{ s.s9.outro }}</p>
    </div>

    <div class="doc-section" id="s10">
      <h2><span class="sec-num">10</span> {{ s.s10.title }}</h2>
      <p>{{ s.s10.intro }}</p>
      <div class="rights-grid">
        {%- for r in s.s10.rights %}
        <div class="right-card"><h4>{{ r.title }}</h4><p>{{ r.body }}</p></div>
        {%- endfor %}
      </div>
      <p>{{ s.s10.outro }}</p>
    </div>

    <div class="doc-section" id="s11">
      <h2><span class="sec-num">11</span> {{ s.s11.title }}</h2>
      {%- for sub in s.s11.subheadings %}
      <h3>{{ sub.title }}</h3>
      <p>{{ sub.intro }}</p>
      {%- endfor %}
      <p>{{ s.s11.outro }}</p>
    </div>

    <div class="doc-section" id="s12">
      <h2><span class="sec-num">12</span> {{ s.s12.title }}</h2>
      {%- for para in s.s12.body %}<p>{{ para }}</p>{% endfor %}
    </div>

    <div class="doc-section" id="s13">
      <h2><span class="sec-num">13</span> {{ s.s13.title }}</h2>
      <p>{{ s.s13.intro }}</p>
      <ul>{% for li in s.s13.list %}<li>{{ li }}</li>{% endfor %}</ul>
      <p>{{ s.s13.outro }}</p>
    </div>

    <div class="doc-section" id="s14">
      <h2><span class="sec-num">14</span> {{ s.s14.title }}</h2>
      <p>{{ s.s14.intro }}</p>
      {%- for para in s.s14.body %}<p>{{ para }}</p>{% endfor %}
    </div>

    <div class="doc-section" id="s15">
      <h2><span class="sec-num">15</span> {{ s.s15.title }}</h2>
      <p>{{ s.s15.intro }}</p>
      <div class="contact-card">
        <div>
          <h4>{{ s.s15.cardTitle }}</h4>
          <p>{{ s.s15.cardBody }}</p>
        </div>
        <a href="mailto:info@nordicriser.com">info@nordicriser.com</a>
      </div>
    </div>

  </div>
</div>
