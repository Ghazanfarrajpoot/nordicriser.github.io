{%- set t = locales[locale] -%}
{%- set lsId = "langSwitch-" + (lsVariant | default("default")) -%}
{% import "partials/icons.njk" as icons %}
<div class="nr-lang-switch" id="{{ lsId }}">
  <button type="button" class="nr-lang-btn" onclick="toggleLangMenu(this)" aria-haspopup="true" aria-expanded="false" aria-controls="{{ lsId }}-menu" aria-label="{{ t.nav.languageLabel }}">
    <span class="nr-lang-globe" aria-hidden="true">{{ icons.icon('globe') }}</span>
    <span class="nr-lang-code">{{ locale | upper }}</span>
  </button>
  <ul class="nr-lang-menu" id="{{ lsId }}-menu">
    {%- if singleLocale %}
    {#- This page only exists in one locale (e.g. the noindex portal bridge page) —
        other-locale links would 404, so just list the current one. -#}
    <li><a href="{{ pageSlug | localeUrl(locale) }}" data-lang="{{ locale }}" class="current" data-analytics-event="language_change">{{ site.locales | localeName(locale) }}</a></li>
    {%- else %}
    {%- for l in site.locales %}
    <li><a href="{{ pageSlug | localeUrl(l.code) }}" data-lang="{{ l.code }}"{% if l.code == locale %} class="current"{% endif %} data-analytics-event="language_change">{{ l.name }}</a></li>
    {%- endfor %}
    {%- endif %}
  </ul>
</div>
