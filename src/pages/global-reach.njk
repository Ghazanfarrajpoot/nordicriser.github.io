---
pagination:
  data: site.locales
  size: 1
  alias: loc
permalink: "{{ 'global-reach' | localePath(loc.code) }}index.html"
eleventyComputed:
  locale: "{{ loc.code }}"
  dir: "{{ loc.dir }}"
layout: layouts/page.njk
pageKey: globalReach
pageSlug: global-reach
bodyClass: "has-gr-sticky"
---
{%- set t = locales[locale] -%}
{%- set p = t.pages.globalReach -%}
{#- notesLabel is newer than most locales' translations — fall back to the
    English caption rather than rendering an empty label. -#}
{%- set heroNotesLabel = p.hero.visual.notesLabel or locales.en.pages.globalReach.hero.visual.notesLabel -%}
{#- demoPlaceholder/demoAriaLabel/notePersistence/classroom are new keys that
    may not have a human translation in every locale yet — fall back to
    English rather than rendering empty. -#}
{%- set grDemoPlaceholder = p.hero.visual.demoPlaceholder or locales.en.pages.globalReach.hero.visual.demoPlaceholder -%}
{%- set grDemoAriaLabel = p.hero.visual.demoAriaLabel or locales.en.pages.globalReach.hero.visual.demoAriaLabel -%}
{%- set notePersistence = p.notePersistence or locales.en.pages.globalReach.notePersistence -%}
{%- set classroom = p.classroom or locales.en.pages.globalReach.classroom -%}
{% import "partials/icons.njk" as icons %}

<section class="page-hero">
  <div class="page-hero-inner" data-animate>
    <span class="gr-early-access-badge">{{ p.hero.earlyAccessBadge }}</span>
    <span class="page-hero-label">{{ p.hero.label }}</span>
    <h1>{{ p.hero.h1 }}</h1>
    <p>{{ p.hero.body }}</p>
    <div class="hero-ctas">
      <a href="https://portal.nordicriser.com" class="btn-primary" data-analytics-event="global_reach_start">{{ p.hero.ctaPrimary }}</a>
      <a href="#how-it-works" class="btn-secondary">{{ p.hero.ctaSecondary }}</a>
    </div>
    <p class="gr-trust-line">{{ p.hero.trustLine }}</p>

    <div class="gr-hero-visual">
      <div class="gr-lang-badges" aria-hidden="true" data-gr-presence>
        {%- for participant in p.hero.visual.participants %}
        <span class="gr-lang-badge" data-gr-lang="{{ participant.lang }}">
          <span class="gr-lang-badge-main"><span class="gr-lang-badge-code">{{ participant.lang }}</span> {{ participant.name }}</span>
          <span class="gr-lang-badge-time" data-gr-time></span>
        </span>
        {%- endfor %}
      </div>
      <div class="gr-hero-notes">
        {{ icons.icon('pencil') }}
        <span class="gr-hero-notes-label">{{ heroNotesLabel }}</span>
        <textarea
          id="grHeroNoteDemo"
          class="gr-hero-notes-input"
          rows="2"
          placeholder="{{ grDemoPlaceholder }}"
          aria-label="{{ grDemoAriaLabel }}"
          data-gr-demo-input
        ></textarea>
      </div>
    </div>
    <p class="gr-mock-caption">{{ p.hero.mockCaption }}</p>
  </div>
</section>

<div class="breadcrumb">
  <div class="breadcrumb-inner">
    <a href="{{ '' | localeUrl(locale) }}">{{ t.common.home }}</a> &rsaquo; <span>{{ p.breadcrumb }}</span>
  </div>
</div>

<section class="section" id="how-it-works">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.howItWorksLabel }}</span>
    <h2 class="section-title">{{ p.howItWorksTitle }}</h2>
    <p class="section-sub">{{ p.howItWorksSub }}</p>
    <div class="steps-grid">
      {%- for step in p.howItWorks %}
      <div class="step">
        <div class="step-number">{{ loop.index }}</div>
        <h3>{{ step.title }}</h3>
        <p>{{ step.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-box" data-animate>
    <h2>{{ p.ctaBand1.title }}</h2>
    <p>{{ p.ctaBand1.body }}</p>
    <a href="https://portal.nordicriser.com" class="btn-cta" data-analytics-event="global_reach_start">{{ p.ctaBand1.cta }}</a>
  </div>
</section>

<section class="section">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ classroom.label }}</span>
    <h2 class="section-title">{{ classroom.title }}</h2>
    <p class="section-sub">{{ classroom.intro }}</p>
    <div class="gr-compare-grid">
      <div class="gr-compare-card">
        {{ icons.icon('calendar') }}
        <h3>{{ classroom.classroomHeading }}</h3>
        <p>{{ classroom.classroomBody }}</p>
      </div>
      <div class="gr-compare-card gr-compare-card-accent">
        {{ icons.icon('globe') }}
        <h3>{{ classroom.grHeading }}</h3>
        <p>{{ classroom.grBody }}</p>
      </div>
    </div>
    <p class="gr-limit-note">{{ classroom.note }}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.useCasesLabel }}</span>
    <h2 class="section-title">{{ p.useCasesTitle }}</h2>
    <div class="audience-grid">
      {%- for uc in p.useCases %}
      <div class="audience-card">
        <h3>{{ uc.title }}</h3>
        <p>{{ uc.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner section-inner-narrow" data-animate>
    <div class="gr-note-persistence">
      {{ icons.icon('lock') }}
      <div>
        <span class="section-label">{{ notePersistence.label }}</span>
        <h2 class="section-title">{{ notePersistence.title }}</h2>
        <p class="section-sub">{{ notePersistence.body }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="pricing">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.plansLabel }}</span>
    <h2 class="section-title">{{ p.plansTitle }}</h2>
    <p class="section-sub">{{ p.plansSub }}</p>
    <div class="gr-plans-grid">
      {%- for plan in p.plans %}
      <div class="gr-plan-card{% if plan.popular %} popular{% endif %}">
        {%- if plan.popular %}<span class="gr-plan-badge">★</span>{% endif %}
        <div class="gr-plan-name">{{ plan.name }}</div>
        <div class="gr-plan-price">${{ plan.price }} <span>{{ plan.period }}</span></div>
        <ul class="gr-plan-features">
          {%- for f in plan.features %}<li>{{ f }}</li>{% endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
    <p class="gr-limit-note">{{ p.limitNote }}</p>
    {#- p._syncNote is an internal reminder for whoever maintains this page — not rendered to visitors. #}
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner" data-animate>
    <span class="section-label">{{ p.faqLabel }}</span>
    <h2 class="section-title">{{ p.faqTitle }}</h2>
    <div class="gr-faq-list">
      {%- for item in p.faq %}
      <div class="gr-faq-item">
        <h3>{{ icons.icon('question') }} {{ item.q }}</h3>
        <p>{{ item.a }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner" data-animate>
    <div class="gr-email-capture">
      <h3>{{ p.emailCapture.title }}</h3>
      <p>{{ p.emailCapture.body }}</p>
      <form class="gr-email-form" id="grNotifyForm" data-locale="{{ locale }}" data-success-text="{{ p.emailCapture.successText }}" data-error-text="{{ p.emailCapture.errorText }}" data-analytics-event="global_reach_notify_submit">
        <input type="email" name="email" id="grNotifyEmail" placeholder="{{ p.emailCapture.placeholder }}" required aria-label="{{ p.emailCapture.placeholder }}">
        <button type="submit">{{ p.emailCapture.button }}</button>
        <label class="gr-consent">
          <input type="checkbox" name="consent" id="grNotifyConsent" required>
          <span>{{ p.emailCapture.consent }} <a href="{{ 'legal/privacy' | localeUrl(locale) }}">{{ p.emailCapture.privacyLinkLabel }}</a></span>
        </label>
        <p class="gr-form-status" id="grNotifyStatus" role="status" hidden></p>
      </form>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="cta-box" data-animate>
    <h2>{{ p.cta.title }}</h2>
    <p>{{ p.cta.body }}</p>
    <a href="https://portal.nordicriser.com" class="btn-cta" data-analytics-event="global_reach_start">{{ t.common.signUp }}</a>
    <p class="gr-trust-line">{{ p.cta.trustLine }}</p>
  </div>
</section>

<div class="gr-sticky-cta" role="complementary" aria-label="{{ p.hero.ctaPrimary }}">
  <span>{{ p.stickyBar.text }}</span>
  <a href="https://portal.nordicriser.com" data-analytics-event="global_reach_start">{{ p.stickyBar.cta }}</a>
</div>
